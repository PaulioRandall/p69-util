{
	"author": "Paul Williams",
	"name": "@paulio/p69-util",
	"description": "Utility tools designed for P69",
	"type": "module",
	"license": "MIT",
	"version": "1.0.0-rc-1",
	"engines": {
		"node": ">=18"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/PaulioRandall/p69-util.git"
	},
	"keywords": [
		"css",
		"util"
	],
	"exports": {
		".": "./lib/index.js"
	},
	"scripts": {
		"fmt": "prettier --log-level warn --write .",
		"test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --silent --runInBand",
